# Spring Boot Backend Environment Variables
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
# Local H2 development fallback: jdbc:h2:mem:ecocarbon;DB_CLOSE_DELAY=-1;MODE=MySQL
# Production MySQL example: jdbc:mysql://localhost:3306/carbon?useSSL=false&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/carbon?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=ecouser
DB_PASSWORD=ecopassword

# Security & JWT Configuration (generate a strong 256-bit key for production)
JWT_SECRET=your_production_secure_jwt_secret_here_min_256_bits
JWT_EXPIRATION=604800000

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS Whitelist (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://ecocarbon.netlify.app

