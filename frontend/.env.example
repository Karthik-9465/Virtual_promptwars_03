# Spring Boot Backend API Base URL
# Local Development: leave blank to use the Vite proxy (http://localhost:8080)
# Production (Netlify): set to your Render or Railway Spring Boot URL (e.g. https://your-spring-app.onrender.com)
VITE_API_BASE_URL=

# Optional: Amazon API Gateway Endpoint for AWS Lambda Carbon Calculator
# (Only needed if optionally testing serverless AWS Lambda)
VITE_AWS_API_GATEWAY_URL=
